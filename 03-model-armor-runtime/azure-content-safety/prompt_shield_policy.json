{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "policy_name": "Azure_AI_ContentSafety_PromptShield_Fortress",
  "version": "2.1.0",
  "author": "Shibin Antony",
  "repository": "github.com/shibinantony/triad-ai-governance-mesh",
  "governance_alignment": {
    "nist_ai_rmf": "MANAGE-1.3",
    "mitre_atlas": ["AML.T0051", "AML.T0051.001", "AML.T0057", "AML.T0058"],
    "owasp_llm": ["LLM01", "LLM02", "LLM06", "LLM07"]
  },
  "prompt_shield_configuration": {
    "user_prompt_analysis": {
      "enabled": true,
      "risk_threshold": 0.70,
      "enforcement_action": "BLOCK",
      "action_on_detection": {
        "http_status_code": 400,
        "error_code": "PROMPT_INJECTION_DETECTED",
        "client_message": "[BLOCKED_BY_POLICY_GATEWAY] Prompt failed Azure AI Content Safety Prompt Shield validation."
      }
    },
    "document_analysis": {
      "enabled": true,
      "indirect_prompt_injection_detection": true,
      "risk_threshold": 0.65,
      "enforcement_action": "BLOCK",
      "description": "Inspects external RAG documents, emails, and attachments for embedded instruction overrides before LLM ingestion."
    }
  },
  "content_safety_severity_thresholds": {
    "hate": {
      "severity_level": 2,
      "action": "BLOCK",
      "description": "Scale 0-7: Level 2 represents low-to-medium threshold"
    },
    "self_harm": {
      "severity_level": 2,
      "action": "BLOCK"
    },
    "sexual": {
      "severity_level": 2,
      "action": "BLOCK"
    },
    "violence": {
      "severity_level": 2,
      "action": "BLOCK"
    }
  },
  "blocklists": {
    "enforce_blocklists": true,
    "blocklist_names": [
      "triad-system-prompt-anchors",
      "triad-destructive-tool-verbs",
      "triad-credential-patterns"
    ],
    "action": "BLOCK"
  },
  "egress_dlp_and_protected_material": {
    "detect_protected_code": {
      "enabled": true,
      "action": "BLOCK_OR_ATTRIBUTION"
    },
    "pii_redaction": {
      "enabled": true,
      "action": "REDACT",
      "entities": [
        "Email",
        "SSN",
        "CreditCardNumber",
        "PhoneNumber",
        "AzureSecretKey"
      ]
    }
  },
  "telemetry": {
    "diagnostic_logging": true,
    "log_masked_text_only": true,
    "destination": "Azure_Log_Analytics_Workspace_Triad"
  }
}
